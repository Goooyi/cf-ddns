#!name=Cloudflare DDNS
#!desc=Update one Cloudflare A record from cip.cc every 5 minutes. Configure once with surge-cli setup.
#!system=mac

[Script]
Cloudflare DDNS = type=cron, cronexp="*/5 * * * *", script-path=https://raw.githubusercontent.com/Goooyi/cf-ddns/main/surge-cloudflare-ddns.js, script-update-interval=3600, timeout=30, wake-system=true

[Rule]
DOMAIN,cip.cc,DIRECT
DOMAIN,api.cloudflare.com,DIRECT
